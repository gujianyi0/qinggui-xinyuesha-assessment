{
  "name": "qinggui-game-assistant-web",
  "version": "2.0.1-local.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts vite.config.ts --error-on-warnings",
    "lint:fix": "biome check src scripts vite.config.ts --write",
    "format": "biome format src scripts vite.config.ts --write",
    "knip": "knip --no-progress",
    "check": "npm run lint && npm run architecture && npm run typecheck && npm run knip && npm test -- --maxWorkers=1 && npm run build",
    "build:local": "tsc -b && node scripts/build-local.mjs",
    "architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "6.1.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^28.0.0",
    "knip": "6.45.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.0.0"
  }
}
