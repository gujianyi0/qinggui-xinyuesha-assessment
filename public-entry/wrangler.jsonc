{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qinggui-assessment",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "CONTROL_TOKEN"
    ]
  },
  "assets": {
    "directory": "../.local/public-entry/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAYS",
        "class_name": "OwnerRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OwnerRelay"
      ]
    }
  ]
}
